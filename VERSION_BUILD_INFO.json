{
  "product": "MiControl",
  "version": "2.0.8",
  "repository": "https://github.com/morey-z/MiControl",
  "baseRevision": "ce5a9de934c95062a6bc303cc22b44a0e1cfb63f",
  "buildChannel": "stable",
  "productionFeature": "custom-protocol",
  "packageManager": "pnpm@10.15.0",
  "sourceManifest": "SOURCE_MANIFEST.json",
  "buildCommands": [
    "corepack pnpm install --frozen-lockfile",
    "corepack pnpm build",
    "cargo build --manifest-path crates/micontrol-windows/Cargo.toml --bin micontrol-service-cleanup --release",
    "corepack pnpm tauri build"
  ],
  "artifactHashes": "See the release package RELEASE_MANIFEST.json; source metadata does not embed machine-local artifact paths.",
  "verificationBoundary": {
    "sourceAndStaticTests": true,
    "installerBuild": true,
    "hardwareAndBluetoothAcceptance": "Previously verified on the accepted rc4 build; not repeated by packaging.",
    "continuousSpeechBeyondFirmwareLimit": false
  }
}
